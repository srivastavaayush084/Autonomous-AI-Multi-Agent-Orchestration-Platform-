# Autonomous AI Multi-Agent Platform Environment Configuration

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# MongoDB Atlas Configuration
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=multi_agent_platform

# LLM Providers Configuration (Hybrid Mode)
DEFAULT_MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:latest

# Cloud LLM Fallbacks (Optional - will be used if Ollama is unreachable or for high-complexity tasks)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Model Router Configuration
ROUTER_STRATEGY=ml_hybrid  # Options: rules_only, ml_only, ml_hybrid
CONFIDENCE_THRESHOLD=0.65

# Security & Safety Execution Sandbox
DOCKER_SANDBOX_ENABLED=false
REQUIRE_HUMAN_APPROVAL_FOR_DESTRUCTIVE=true
EXECUTION_BUDGET_SECONDS=300
MAX_AGENT_RETRIES=3
